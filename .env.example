# LLM 配置（兼容 OpenAI API 格式，DashScope）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash

# 最大反思次数
MAX_REFINEMENTS=2

# Embedding 配置
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_SIZE=10

# 存储目录
STORAGE_DIR=./data/storage

# 记忆配置
WORKING_MEMORY_TTL_HOURS=24
CORE_MEMORY_LIMIT=500
MEMORY_EXTRACTION_ENABLED=true
MEMORY_IMPORTANCE_THRESHOLD=0.3

# 评估配置
EVAL_ENABLED=true
EVAL_HARD_CASE_THRESHOLD=5
EVAL_GOLDEN_MODEL=
EVAL_RETENTION_DAYS=30
EVAL_MAINTENANCE_INTERVAL_HOURS=6

# Database（用于数据分析 Worker）
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=

# 图表输出目录（用于数据分析 Worker）
CHARTS_OUTPUT_DIR=./data/charts

# Redis（必填，替代文件存储）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Web API
WEB_SECRET_KEY=change-me-in-production
